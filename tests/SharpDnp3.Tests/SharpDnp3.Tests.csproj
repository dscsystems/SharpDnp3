<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpDnp3.Tests</RootNamespace>
    <AssemblyName>SharpDnp3.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xUnit1051 wants TestContext.Current.CancellationToken threaded through
         every awaited call. These tests own their own lifetime through
         TestPair, which cancels its sessions on dispose, so the rule is noise
         here. -->
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="1.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpDnp3/SharpDnp3.csproj" />
  </ItemGroup>

</Project>
